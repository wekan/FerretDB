# syntax=docker/dockerfile:1

# Builds the FerretDB images from the PREBUILT per-arch binaries attached to a
# GitHub Release (downloaded into ./dist/ferretdb-<arch> and
# ./dist/ferretdb-sqlite-<arch>) - no compiling. FERRETDB_ASSET picks which. Used by
# .github/workflows/docker.yml. The pick stage runs on the native build platform
# and just selects the binary matching the target platform, so buildx emits every
# supported runtime architecture present in ./dist.
#
# See Dockerfile.release.dockerignore for the build context (the ./dist dir +
# build/ferretdb passwd/group), and Dockerfile for the build-from-source variant
# used by release-all.yml.
#
# The runtime is gcr.io/distroless/static-debian13: CA certificates, tzdata,
# netbase and media types, and nothing else - no C library, no shell, no package
# manager. The ferretdb binary is static (CGO_ENABLED=0, build.sh) and needs
# nothing more. The image used to carry mongosh, with the Node.js it runs on,
# and so glibc, libstdc++, libgcc_s and libatomic from Debian: every finding of
# Artifact Hub's scan of the image (42 in v1.114.0, none with a Debian fix) was
# in those, and nothing of FerretDB used them. A mongosh is run from anywhere
# else, against the published port. The tag is not pinned by digest, as no other
# base image here is: an image built from a release takes the newest distroless
# rebuild, and with it Debian's newest security updates.
#
# Distroless publishes amd64, arm64, arm/v7, ppc64le, s390x and riscv64. For
# 386, which it does not publish, runtime-386 is the same Debian packages, from
# debian:trixie-slim, in scratch (the static-root stage), so every platform of
# build/ferretdb/release-platforms.sh keeps its image.

FROM --platform=$BUILDPLATFORM busybox AS pick
ARG TARGETARCH
ARG TARGETVARIANT
# Which release binary the image is made of: ferretdb (ferretdb-<arch>, every
# handler) for the ferretdb image, ferretdb-sqlite (ferretdb-sqlite-<arch>,
# the sqlite handler only) for the ferretdb-sqlite image. build/ferretdb/
# publish-docker.sh passes it; everything else in the two images is the same.
ARG FERRETDB_ASSET=ferretdb
COPY dist /bins
RUN set -eux; \
    # Map the OCI target platform to the arch name used in the binary name.
    case "${TARGETARCH}/${TARGETVARIANT}" in \
      amd64/*)   n=amd64 ;; \
      arm64/*)   n=arm64 ;; \
      arm/v7)    n=armhf ;; \
      arm/v6)    n=armv6 ;; \
      arm/v5)    n=armel ;; \
      arm/)      n=armhf ;; \
      386/*)     n=i386 ;; \
      ppc64le/*) n=ppc64le ;; \
      s390x/*)   n=s390x ;; \
      riscv64/*) n=riscv64 ;; \
      loong64/*) n=loong64 ;; \
      *) echo "no prebuilt ${FERRETDB_ASSET} for ${TARGETARCH}/${TARGETVARIANT}" >&2; exit 1 ;; \
    esac; \
    case "${FERRETDB_ASSET}" in ferretdb|ferretdb-sqlite) ;; *) echo "unknown FERRETDB_ASSET ${FERRETDB_ASSET}" >&2; exit 1 ;; esac; \
    cp "/bins/${FERRETDB_ASSET}-${n}" /ferretdb; \
    chmod 0755 /ferretdb; \
    mkdir -p /state; \
    chown 1000:1000 /state

# 386 only: the packages gcr.io/distroless/static-debian13 is made of, unpacked
# into /add, each with its dpkg record in /add/var/lib/dpkg/status.d/<package>,
# where distroless keeps its own, so an image scanner still sees every package.
# Runs as the target (386 runs natively on an amd64 runner). `upgrade` takes the
# Debian security updates released since debian:trixie-slim was last published.
FROM debian:trixie-slim AS static-root
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates tzdata tzdata-legacy netbase media-types \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    mkdir -p /add/var/lib/dpkg/status.d; \
    for p in base-files netbase tzdata tzdata-legacy media-types ca-certificates; do \
      dpkg-query -L "$p" | while read -r f; do \
        case "$f" in /usr/share/doc/*|/usr/share/man/*|/usr/share/lintian/*|/usr/sbin/*|/usr/share/ca-certificates/*) continue ;; esac; \
        if [ -L "$f" ] || [ -f "$f" ]; then \
          d="$(readlink -f "$(dirname "$f")")"; mkdir -p "/add$d"; cp -a "$f" "/add$d/"; \
        fi; \
      done; \
      dpkg-query -s "$p" > "/add/var/lib/dpkg/status.d/$p"; \
    done; \
    cp -a --parents /etc/ssl/certs/ca-certificates.crt /add/; \
    mkdir -p -m 1777 /add/tmp; \
    test -s /add/etc/ssl/certs/ca-certificates.crt; \
    test -e /add/usr/share/zoneinfo/UTC

FROM gcr.io/distroless/static-debian13:nonroot AS runtime-amd64
FROM gcr.io/distroless/static-debian13:nonroot AS runtime-arm64
FROM gcr.io/distroless/static-debian13:nonroot AS runtime-arm
FROM gcr.io/distroless/static-debian13:nonroot AS runtime-ppc64le
FROM gcr.io/distroless/static-debian13:nonroot AS runtime-s390x
FROM gcr.io/distroless/static-debian13:nonroot AS runtime-riscv64
FROM scratch AS runtime-386
COPY --from=static-root /add/ /

FROM runtime-${TARGETARCH} AS final

# The same ferretdb user, uid and gid 1000, as before the distroless runtime:
# existing /state volumes are owned by it.
COPY build/ferretdb/passwd /etc/passwd
COPY build/ferretdb/group  /etc/group

COPY --from=pick /ferretdb /ferretdb
COPY --from=pick --chown=1000:1000 /state /state

USER ferretdb:ferretdb

# Verify the binary runs on the target before any registry receives an image.
# It needs no database or network service, and no shell: an exec-form RUN.
RUN ["/ferretdb", "--version"]

ENTRYPOINT ["/ferretdb"]

WORKDIR /
VOLUME /state
EXPOSE 27017 8088

ENV FERRETDB_LISTEN_ADDR=0.0.0.0:27017
ENV FERRETDB_STATE_DIR=/state
ENV FERRETDB_HANDLER=sqlite
ENV FERRETDB_SQLITE_URL=file:/state/
ENV FERRETDB_TELEMETRY=disable
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
