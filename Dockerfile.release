# syntax=docker/dockerfile:1

# Builds the FerretDB image from the PREBUILT per-arch binaries attached to a
# GitHub Release (downloaded into ./dist/ferretdb-<arch>) — no compiling. Used by
# .github/workflows/docker.yml. The pick stage runs on the native build platform
# and just selects the binary matching the target platform, so buildx emits every
# architecture present in ./dist WITHOUT QEMU. Final image is FROM scratch
# (architecture-agnostic).
#
# See Dockerfile.release.dockerignore for the build context (the ./dist dir +
# build/ferretdb passwd/group), and Dockerfile for the build-from-source variant
# used by release-all.yml.

FROM --platform=$BUILDPLATFORM busybox AS pick
ARG TARGETARCH
ARG TARGETVARIANT
COPY dist /bins
RUN set -eux; \
    # Map the OCI target platform to the arch name used in the binary name.
    case "${TARGETARCH}/${TARGETVARIANT}" in \
      amd64/*)   n=amd64 ;; \
      arm64/*)   n=arm64 ;; \
      arm/v7)    n=armhf ;; \
      arm/v6)    n=armhf ;; \
      arm/v5)    n=armel ;; \
      arm/)      n=armhf ;; \
      386/*)     n=i386 ;; \
      ppc64le/*) n=ppc64le ;; \
      s390x/*)   n=s390x ;; \
      riscv64/*) n=riscv64 ;; \
      loong64/*) n=loong64 ;; \
      *) echo "no prebuilt ferretdb for ${TARGETARCH}/${TARGETVARIANT}" >&2; exit 1 ;; \
    esac; \
    cp "/bins/ferretdb-${n}" /ferretdb; \
    chmod 0755 /ferretdb; \
    mkdir -p /state; \
    chown 1000:1000 /state

FROM scratch AS final

COPY build/ferretdb/passwd /etc/passwd
COPY build/ferretdb/group  /etc/group
USER ferretdb:ferretdb

COPY --from=pick /ferretdb /ferretdb
COPY --from=pick --chown=ferretdb:ferretdb /state /state

ENTRYPOINT ["/ferretdb"]

WORKDIR /
VOLUME /state
EXPOSE 27017 8088

ENV FERRETDB_LISTEN_ADDR=0.0.0.0:27017
ENV FERRETDB_STATE_DIR=/state
ENV FERRETDB_HANDLER=sqlite
ENV FERRETDB_SQLITE_URL=file:/state/
ENV FERRETDB_TELEMETRY=disable
