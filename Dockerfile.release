# syntax=docker/dockerfile:1

# Builds the FerretDB image from the PREBUILT per-arch binaries attached to a
# GitHub Release (downloaded into ./dist/ferretdb-<arch>) — no compiling. Used by
# .github/workflows/docker.yml. The pick stage runs on the native build platform
# and just selects the binary matching the target platform, so buildx emits every
# supported runtime architecture present in ./dist. The matching mongosh package is
# assembled by wekan/mongosh-patches with the already-built node-patches runtime.
#
# See Dockerfile.release.dockerignore for the build context (the ./dist dir +
# build/ferretdb passwd/group), and Dockerfile for the build-from-source variant
# used by release-all.yml.

FROM --platform=$BUILDPLATFORM busybox AS pick
ARG TARGETARCH
ARG TARGETVARIANT
COPY dist /bins
RUN set -eux; \
    # Map the OCI target platform to the arch name used in the binary name.
    case "${TARGETARCH}/${TARGETVARIANT}" in \
      amd64/*)   n=amd64 ;; \
      arm64/*)   n=arm64 ;; \
      arm/v7)    n=armhf; m=armv7 ;; \
      arm/v6)    n=armv6; m=armv6 ;; \
      arm/v5)    n=armel ;; \
      arm/)      n=armhf ;; \
      386/*)     n=i386 ;; \
      ppc64le/*) n=ppc64le ;; \
      s390x/*)   n=s390x ;; \
      riscv64/*) n=riscv64 ;; \
      loong64/*) n=loong64 ;; \
      *) echo "no prebuilt ferretdb for ${TARGETARCH}/${TARGETVARIANT}" >&2; exit 1 ;; \
    esac; \
    cp "/bins/ferretdb-${n}" /ferretdb; \
    chmod 0755 /ferretdb; \
    m="${m:-$n}"; \
    test -f "/bins/mongosh-${m}.tgz"; \
    mkdir -p /mongosh; \
    tar -xzf "/bins/mongosh-${m}.tgz" -C /mongosh --strip-components=1; \
    test -x /mongosh/mongosh; \
    if [ "$n" = ppc64le ]; then \
      cp /bins/official-node-ppc64le /mongosh/bin/node.official; \
      cp /bins/official-node-ppc64le.version /mongosh/bin/node.official.version; \
      cp /bins/official-node-ppc64le.LICENSE /mongosh/LICENSE-node-official; \
    fi; \
    mkdir -p /state; \
    chown 1000:1000 /state

FROM debian:trixie-slim AS final

# Node packages are linked against newer glibc and libstdc++ than bookworm.
# Official PowerPC Node also requires libatomic.so.1 (libatomic1).
# Unlike the native pick stage, this runs on the target CPU (QEMU in CI).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libstdc++6 libatomic1 \
    && rm -rf /var/lib/apt/lists/*

COPY build/ferretdb/passwd /etc/passwd
COPY build/ferretdb/group  /etc/group

COPY --from=pick /ferretdb /ferretdb
COPY --from=pick /mongosh /opt/mongosh
COPY --from=pick --chown=ferretdb:ferretdb /state /state

# Keep the package version: reject an outdated or mismatched replacement before
# selecting the official native PPC build. The packaged cross-built V8 snapshot
# fails even on node -e; changing mongosh flags cannot repair it.
RUN if [ -f /opt/mongosh/bin/node.official ]; then \
      expected="$(cat /opt/mongosh/bin/node.official.version)"; \
      test "$(/opt/mongosh/bin/node --version)" = "$expected" \
      && test "$(/opt/mongosh/bin/node.official --version)" = "$expected" \
      && mv /opt/mongosh/bin/node.official /opt/mongosh/bin/node; \
    fi

USER ferretdb:ferretdb

# Verify the target loader, shared libraries, launcher and JS bundle before any
# registry receives an image. These commands need no database or network service.
RUN /ferretdb --version \
    && /opt/mongosh/bin/node --version | grep -E '^v26\.' \
    && /opt/mongosh/bin/node -e "if (1 + 1 !== 2) process.exit(1)" \
    && /opt/mongosh/mongosh --version

ENTRYPOINT ["/ferretdb"]

WORKDIR /
VOLUME /state
EXPOSE 27017 8088

ENV FERRETDB_LISTEN_ADDR=0.0.0.0:27017
ENV FERRETDB_STATE_DIR=/state
ENV FERRETDB_HANDLER=sqlite
ENV FERRETDB_SQLITE_URL=file:/state/
ENV FERRETDB_TELEMETRY=disable
ENV PATH=/opt/mongosh:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
